# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — it contains secrets!

# A long random string used to sign JWT tokens
# Generate one at: https://generate-secret.vercel.app/32
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Port for the API server (default 3001)
PORT=3001

# Your frontend URL (used for CORS)
# In production, set this to your Vercel frontend URL
FRONTEND_URL=http://localhost:3000
