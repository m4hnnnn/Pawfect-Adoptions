  return `<div style="padding-top:100px;padding-bottom:80px">
    <div style="max-width:1000px;margin:0 auto;padding:40px 32px">
      <div style="text-align:center;margin-bottom:64px">
        <p style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--sage);margin-bottom:12px;font-weight:500">Say hello</p>
        <h1 style="font-family:var(--fd);font-size:clamp(40px,7vw,68px);font-weight:400;color:var(--td);margin-bottom:16px;line-height:1.1">We'd love to<br><em style="color:var(--pk400);font-style:italic">hear from you</em></h1>
