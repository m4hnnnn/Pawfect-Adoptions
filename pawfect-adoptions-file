          ${[['📍','Address','420 N. Magnolia Ave<br>Chicago, IL 60622'],['📞','Phone','(312) 555-0148'],['✉️','Email','hello@pawfect.co'],['🕐','Hours','Tue–Sun · 11am–6pm']].map(([e,l,v])=>`<div class="contact-info-box"><div class="contact-icon">${e}</div><div><p style="font-size:12px;color:var(--tl);letter-spacing:.05em;text-transform:uppercase;margin-bottom:4px">${l}</p><p style="font-size:14px;color:var(--td);line-height:1.5">${v}</p></div></div>`).join('')}
