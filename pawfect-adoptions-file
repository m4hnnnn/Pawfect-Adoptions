function renderAdopt(){
  const filtered=CATS.filter(c=>{
    if(currentFilter==='All')return true;
    if(currentFilter==='Female')return c.gender==='Female';
    if(currentFilter==='Male')return c.gender==='Male';
    if(currentFilter==='Kitten')return c.age.includes('month');
    if(currentFilter==='Adult')return c.age.includes('year');
    return true;
  });
  const filters=['All','Female','Male','Kitten','Adult'];
  return `<div style="max-width:1200px;margin:0 auto;padding:100px 32px 80px">
    <div style="margin-bottom:48px">
      <p style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--sage);margin-bottom:10px;font-weight:500">Adoption gallery</p>
      <h1 style="font-family:var(--fd);font-size:clamp(40px,6vw,64px);font-weight:400;color:var(--td);margin-bottom:16px;line-height:1.1">Meet the cats 🐾</h1>
      <p style="font-size:16px;color:var(--tm);max-width:480px;line-height:1.7">Each of these wonderful souls is looking for their forever home. Take your time, follow your heart.</p>
    </div>
    <div style="display:flex;gap:10px;margin-bottom:40px;flex-wrap:wrap;align-items:center">
      ${filters.map(f=>`<button class="pill-filter${currentFilter===f?' active':''}" onclick="currentFilter='${f}';navigate('adopt')">${f}</button>`).join('')}
      <span style="font-size:13px;color:var(--tl);margin-left:8px">${filtered.length} ${filtered.length===1?'kitty':'kitties'} found</span>
    </div>
    <div class="grid-3">${filtered.length?filtered.map(catCardHTML).join(''):'<div style="text-align:center;padding:80px 0;color:var(--tl);grid-column:1/-1"><div style="font-size:48px;margin-bottom:16px">🔍</div><p>No cats match this filter right now.</p></div>'}</div>
  </div>`;
}

function renderCatDetail(id){
  const cat=CATS.find(c=>c.id===id);
  if(!cat)return`<div style="padding:120px 32px;text-align:center"><p>Cat not found!</p></div>`;
  const fav=isFav(cat.id);
  const u=getUser();
  return `<div style="max-width:1000px;margin:0 auto;padding:100px 32px 80px">
    <button onclick="navigate('adopt')" style="background:none;border:none;cursor:pointer;display:flex;align-items:center;gap:6px;color:var(--tl);font-size:14px;margin-bottom:32px;font-family:var(--fb)">← Back</button>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start">
      <div style="border-radius:var(--r4);background:linear-gradient(135deg,${cat.bg},${cat.bg}bb);height:420px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden">
        <div style="position:absolute;bottom:-50px;right:-50px;width:200px;height:200px;border-radius:50%;background:${cat.accent}20"></div>
        <span style="font-size:120px;filter:drop-shadow(0 8px 24px rgba(0,0,0,.1))">${cat.emoji}</span>
        <div style="position:absolute;top:16px;left:16px;background:${cat.status==='Available'?'var(--gn100)':'var(--pk100)'};color:${cat.status==='Available'?'var(--gn500)':'var(--pk400)'};font-size:12px;font-weight:500;padding:5px 14px;border-radius:20px">${cat.status}</div>
      </div>
      <div>
        <h1 style="font-family:var(--fd);font-size:56px;font-weight:400;color:var(--td);margin-bottom:4px">${cat.name}</h1>
        <p style="font-size:15px;color:var(--tl);margin-bottom:24px">${cat.breed} · ${cat.age} · ${cat.gender} · ${cat.size}</p>
        <p style="font-size:15px;color:var(--tm);line-height:1.75;margin-bottom:28px">${cat.description}</p>
        <div style="margin-bottom:28px">
          <p style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--tl);margin-bottom:10px">Personality</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap">${cat.personality.map(t=>`<span style="background:${cat.bg};color:${cat.accent};font-size:13px;font-weight:500;padding:6px 14px;border-radius:20px">${t}</span>`).join('')}</div>
        </div>
        <div style="background:var(--cream2);border-radius:var(--r2);padding:20px;margin-bottom:32px">
          ${[['Color',cat.color],['Size',cat.size],['Gender',cat.gender]].map(([k,v])=>`<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(244,143,177,.1)"><span style="font-size:13px;color:var(--tl)">${k}</span><span style="font-size:13px;font-weight:500;color:var(--td)">${v}</span></div>`).join('')}
        </div>
        <div style="display:flex;gap:12px">
          ${cat.status==='Available'?`<button class="btn-p" style="flex:1;padding:14px" onclick="navigate('contact')">Apply to adopt 🐾</button>`:`<button class="btn-s" style="flex:1;padding:14px" disabled>Currently pending</button>`}
          ${u?`<button onclick="event.stopPropagation();toggleFav(${cat.id})" style="background:${fav?'var(--pk50)':'#fff'};border:1.5px solid ${fav?'var(--pk300)':'var(--pk100)'};border-radius:var(--r1);padding:14px 20px;cursor:pointer;display:flex;align-items:center;gap:8px;font-family:var(--fb);font-size:13px;color:var(--pk400);font-weight:500;transition:all .2s">${fav?'❤️ Saved':'🤍 Save'}</button>`:''}
        </div>
      </div>
    </div>
  </div>`;
}

function renderAbout(){
  return `<div style="padding-top:100px;padding-bottom:80px">
    <section style="max-width:800px;margin:0 auto;padding:40px 32px 80px;text-align:center">
      <p style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--sage);margin-bottom:16px;font-weight:500">Our story</p>
      <h1 style="font-family:var(--fd);font-size:clamp(44px,7vw,72px);font-weight:400;line-height:1.1;color:var(--td);margin-bottom:24px">Born from love<br><em style="color:var(--pk400);font-style:italic">for cats</em></h1>
      <p style="font-size:17px;color:var(--tm);line-height:1.8;font-weight:300">Pawfect Adoptions started in 2016 when our founder Maya rescued her first stray from a Chicago alley. That cat — named Rosebud — changed her life so profoundly that she built an entire shelter around the idea that every cat deserves to be loved exactly as they are.</p>
    </section>
    <section style="background:linear-gradient(135deg,var(--pk50),var(--gn50));padding:80px 32px">
      <div style="max-width:1000px;margin:0 auto">
        <h2 style="font-family:var(--fd);font-size:44px;font-weight:400;text-align:center;margin-bottom:48px;color:var(--td)">What we believe</h2>
        <div class="grid-4">
          ${[['💗','Love is the answer',"Every behavioral 'problem' is just a cat who hasn't found the right human yet."],['🌿','No cat left behind','We foster the shy ones, the seniors, the special needs. Everyone deserves a chance.'],['🏠','Forever means forever','We stay in touch with our adopters. A Pawfect adoption is a relationship, not a transaction.'],['✨','Joy in the small things','A purr. A slow blink. A biscuit-making session at 3am. This is what life is about.']].map(([e,t,b])=>`<div class="value-card"><div style="font-size:32px;margin-bottom:14px">${e}</div><h3 style="font-family:var(--fd);font-size:22px;font-weight:500;color:var(--td);margin-bottom:10px">${t}</h3><p style="font-size:14px;color:var(--tm);line-height:1.7">${b}</p></div>`).join('')}
        </div>
      </div>
    </section>
    <section style="max-width:900px;margin:0 auto;padding:80px 32px">
      <h2 style="font-family:var(--fd);font-size:44px;font-weight:400;text-align:center;margin-bottom:48px;color:var(--td)">Our team</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px">
        ${[['🌸','Maya Chen','Founder & Cat Whisperer'],['🍃','Lily Park','Head of Adoptions'],['💚','Jade Rivera','Veterinary Liaison']].map(([e,n,r])=>`<div style="text-align:center;padding:32px 24px;background:#fff;border-radius:var(--r4);border:1px solid var(--pk100);box-shadow:var(--shadow)"><div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--pk200),var(--gn200));margin:0 auto 16px;display:flex;align-items:center;justify-content:center;font-size:32px">${e}</div><h3 style="font-family:var(--fd);font-size:22px;font-weight:500;color:var(--td);margin-bottom:6px">${n}</h3><p style="font-size:13px;color:var(--tl)">${r}</p></div>`).join('')}
      </div>
    </section>
  </div>`;
}

