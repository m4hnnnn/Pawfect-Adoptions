function submitContact(e){
  e.preventDefault();
  document.getElementById('contact-msg').innerHTML=`<div class="success-box">🌸 Message sent! We'll get back to you within 24 hours.</div>`;
  e.target.reset();
}

function renderLogin(){
  return `<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:32px;background:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(255,214,231,.4) 0%,rgba(220,237,200,.2) 60%,transparent 100%)">
    <div class="auth-card" style="border:1px solid var(--pk100)">
      <div style="position:absolute;top:-40px;right:-40px;width:150px;height:150px;border-radius:50%;background:var(--pk100);opacity:.5;z-index:0"></div>
      <div style="position:absolute;bottom:-30px;left:-30px;width:100px;height:100px;border-radius:50%;background:var(--gn100);opacity:.5;z-index:0"></div>
      <div style="position:relative;z-index:1">
        <div style="text-align:center;margin-bottom:36px">
          <div style="font-size:40px;margin-bottom:12px">🐾</div>
          <h1 style="font-family:var(--fd);font-size:36px;font-weight:400;color:var(--td);margin-bottom:8px">Welcome back</h1>
          <p style="font-size:14px;color:var(--tl)">Sign in to your Pawfect account</p>
        </div>
        <form onsubmit="doLogin(event)" style="display:flex;flex-direction:column;gap:18px">
          <div><label>Email</label><input id="login-email" type="email" placeholder="you@email.com" required></div>
          <div><label>Password</label><input id="login-pw" type="password" placeholder="••••••••" required></div>
          <div id="login-err"></div>
          <button type="submit" class="btn-p" style="width:100%;padding:14px;font-size:15px">Sign in 🌸</button>
        </form>
        <p style="text-align:center;font-size:14px;color:var(--tl);margin-top:24px">New here? <button onclick="navigate('signup')" style="background:none;border:none;cursor:pointer;color:var(--pk400);font-size:14px;font-weight:500;font-family:var(--fb)">Create an account</button></p>
      </div>
    </div>
  </div>`;
}

function doLogin(e){
  e.preventDefault();
  const email=document.getElementById('login-email').value;
  const pw=document.getElementById('login-pw').value;
  const users=getUsers();
  const found=users.find(u=>u.email===email&&u.password===pw);
  if(!found){document.getElementById('login-err').innerHTML=`<div class="error-box">Invalid email or password</div>`;return}
  saveUser({email:found.email,name:found.name,favorites:found.favorites||[]});
  navigate('home');
}

function renderSignup(){
  return `<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:32px;background:radial-gradient(ellipse 80% 80% at 50% 50%,rgba(220,237,200,.4) 0%,rgba(255,214,231,.2) 60%,transparent 100%)">
    <div class="auth-card" style="border:1px solid var(--gn100)">
      <div style="position:absolute;top:-40px;left:-40px;width:150px;height:150px;border-radius:50%;background:var(--gn100);opacity:.5;z-index:0"></div>
      <div style="position:absolute;bottom:-30px;right:-30px;width:100px;height:100px;border-radius:50%;background:var(--pk100);opacity:.5;z-index:0"></div>
      <div style="position:relative;z-index:1">
        <div style="text-align:center;margin-bottom:36px">
          <div style="font-size:40px;margin-bottom:12px">🌿</div>
          <h1 style="font-family:var(--fd);font-size:36px;font-weight:400;color:var(--td);margin-bottom:8px">Join us</h1>
          <p style="font-size:14px;color:var(--tl)">Create your Pawfect account</p>
        </div>
        <form onsubmit="doSignup(event)" style="display:flex;flex-direction:column;gap:18px">
          <div><label>Full name</label><input id="su-name" placeholder="Your name" required></div>
          <div><label>Email</label><input id="su-email" type="email" placeholder="you@email.com" required></div>
          <div><label>Password</label><input id="su-pw" type="password" placeholder="At least 6 characters" required></div>
          <div id="signup-err"></div>
          <button type="submit" class="btn-g" style="width:100%;padding:14px;font-size:15px">Create account 🌱</button>
        </form>
        <p style="text-align:center;font-size:14px;color:var(--tl);margin-top:24px">Already have an account? <button onclick="navigate('login')" style="background:none;border:none;cursor:pointer;color:var(--pk400);font-size:14px;font-weight:500;font-family:var(--fb)">Sign in</button></p>
      </div>
    </div>
  </div>`;
}

function doSignup(e){
  e.preventDefault();
  const name=document.getElementById('su-name').value;
  const email=document.getElementById('su-email').value;
  const pw=document.getElementById('su-pw').value;
  if(pw.length<6){document.getElementById('signup-err').innerHTML=`<div class="error-box">Password must be at least 6 characters</div>`;return}
  const users=getUsers();
  if(users.find(u=>u.email===email)){document.getElementById('signup-err').innerHTML=`<div class="error-box">Email already registered</div>`;return}
  users.push({name,email,password:pw,favorites:[]});
  saveUsers(users);
  saveUser({name,email,favorites:[]});
  navigate('home');
}

function renderFavorites(){
  const u=getUser();
  if(!u)return`<div style="padding:120px 32px;text-align:center"><div style="font-size:48px;margin-bottom:16px">💗</div><h2 style="font-family:var(--fd);font-size:32px;color:var(--td);margin-bottom:12px">Sign in to see favorites</h2><button class="btn-p" style="margin-top:8px" onclick="navigate('login')">Sign in</button></div>`;
  const favCats=CATS.filter(c=>u.favorites&&u.favorites.includes(c.id));
  return `<div style="max-width:1200px;margin:0 auto;padding:100px 32px 80px">
    <div style="margin-bottom:48px">
      <p style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--pk400);margin-bottom:10px;font-weight:500">Your collection</p>
      <h1 style="font-family:var(--fd);font-size:56px;font-weight:400;color:var(--td);line-height:1.1">Saved cats 💗</h1>
    </div>
    ${favCats.length?`<div class="grid-3">${favCats.map(catCardHTML).join('')}</div>`:`<div style="text-align:center;padding:80px 0"><div style="font-size:56px;margin-bottom:20px">🐱</div><h2 style="font-family:var(--fd);font-size:28px;color:var(--td);margin-bottom:12px">No favorites yet</h2><p style="font-size:15px;color:var(--tl);margin-bottom:28px">Browse our cats and tap the heart to save them here.</p><button class="btn-p" onclick="navigate('adopt')">Meet the cats</button></div>`}
  </div>`;
}

renderPage();
</script>
